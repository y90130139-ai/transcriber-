<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.geno.social-transcriber.funnel</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/geno/projects/social-transcriber/bin/funnel-daily</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/geno/Library/Logs/social-transcriber-funnel.log</string>
	<key>StandardOutPath</key>
	<string>/Users/geno/Library/Logs/social-transcriber-funnel.log</string>
	<!-- 08:00 local, every day. The digest is a to-do list, so it has to arrive
	     before the day is decided, and a link put back at 09:00 still earns the
	     day's traffic. Deliberately twelve hours from the 19:00 scout pass: two
	     browsers on one burner session at once is what makes an account look
	     automated. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/geno/projects/social-transcriber</string>
</dict>
</plist>
