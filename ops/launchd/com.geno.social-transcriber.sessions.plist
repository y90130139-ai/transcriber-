<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.geno.social-transcriber.sessions</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/geno/projects/social-transcriber/bin/session-check</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/geno/Library/Logs/social-transcriber-sessions.log</string>
	<key>StandardOutPath</key>
	<string>/Users/geno/Library/Logs/social-transcriber-sessions.log</string>
	<!-- Every Instagram login — Scout's accounts, the viewer, the downloader —
	     six times a day; alerts Telegram and/or Discord the moment one dies.
	     Kept off 19:00 and the Friday/Saturday pass windows: two browsers on
	     one connection at once is what makes it look automated, and the probe
	     itself defers if a pass or the viewer is running. The worker re-arms a
	     stale check (six hours) on its own, and runs the downloader half the
	     moment a download fails with cookies (src/worker.py). -->
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/geno/projects/social-transcriber</string>
</dict>
</plist>
