#!/usr/bin/env bash
# Thin wrapper so the tool runs from anywhere without activating the venv.
# Resolves its own symlink so it works when linked onto PATH.
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
cd "$ROOT"
exec "$ROOT/.venv/bin/python" -m src.cli "$@"
