# Copy to cloud/.env.local for local runs and scripts. On Vercel these live in
# Project Settings → Environment Variables. Names only — never commit values.

# --- Core (the app will not start without these) ---------------------------
DATABASE_URL=            # Neon Postgres connection string
SESSION_SECRET=          # HMAC key for the console session cookie (long random)
WORKER_SECRET=           # bearer secret for the Mac worker; ALSO signs media URLs (see REVIEW-BRIEF.md)
CRON_SECRET=             # Vercel cron bearer; also guards /api/scout/apify-hook

# --- Canonical origin ------------------------------------------------------
# Where emails, invites and portal links point. The code defaults to
# https://plan.gosianmedia.com — set this only to override (staging, local).
APP_URL=

# --- Team sign-in (same accounts as the ai-invoice dashboard) ---------------
# The console has no password of its own: teammates sign in with their
# ai-invoice email + password, checked against Supabase's team_members.
# CEO/admin are always in; members need their "Transcriber" permission on.
SUPABASE_URL=            # https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY= # service_role key — reads team_members (server only)

# --- Telegram bot (separate repo: gosian-bot) ------------------------------
GOSIAN_BOT_SECRET=       # bearer secret the bot sends on /api/bot/*
OWNER_TELEGRAM_ID=       # Telegram user id allowed to approve /q drafts

# --- Email (Resend; shared with the ai-invoice dashboard) -------------------
# Editor notifications and model invites. Unset = the UI falls back to
# copy-the-link, so email is a convenience, never a hard dependency.
RESEND_API_KEY=
RESEND_FROM=             # e.g. Gosian Media <invitation@gosianmedia.com>

# --- Storage / AI ----------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The worker's OFMPro mirror bucket (platform feeds presign media copies from
# here). Missing = the feeds fall back to CDN links that expire within days.
OFMPRO_R2_ACCOUNT_ID=
OFMPRO_R2_ACCESS_KEY_ID=
OFMPRO_R2_SECRET_ACCESS_KEY=
OFMPRO_R2_BUCKET=        # e.g. gosian
CLOUDFLARE_ACCOUNT_ID=   # falls back to R2_ACCOUNT_ID
CLOUDFLARE_AI_TOKEN=     # Workers AI: cloud transcription fallback, profiler, tagging
ANTHROPIC_API_KEY=       # /q OPS assistant (not yet set in production)

# Azure AI Foundry chat (Trends ask; same deployment as the invoice app)
AZURE_AI_FOUNDRY_ENDPOINT=    # e.g. https://<resource>.services.ai.azure.com/openai/v1
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_DEPLOYMENT=  # default gpt-5.4

# --- Reddit Trends (see docs/REDDIT-TRENDS.md) -----------------------------
# A Reddit app of type "script" (or "web app") registered under your Reddit
# account, approved for the read scope. Server-side only — never exposed to
# the browser. Without these the collector stays disabled with a checklist.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional: a descriptive User-Agent is required by Reddit's API rules.
# Defaults to the app's own name + contact below when unset.
REDDIT_USER_AGENT=
REDDIT_CONTACT=          # e.g. ops@yourdomain.com — goes in the default UA

# --- Scout (Instagram intake via Apify) ------------------------------------
APIFY_TOKEN=
SCOUT_MAX_USD=8          # spend ceiling per Apify run

# --- Earnings (Infloww) ----------------------------------------------------
INFLOWW_API_KEY=
INFLOWW_OID=
EARNINGS_AUTOSEND=0      # 1 = post recaps without OPS approval

# --- Scheduler (Autoposter) ------------------------------------------------
# The social scheduling backend: accounts, media, posts. Server-side only —
# the token must never reach a browser. Without these the Scheduler tab
# shows its own not-connected page instead of the calendar.
AUTOPOSTER_TOKEN=
AUTOPOSTER_WORKSPACES=      # every workspace UUID, comma-separated (one token reaches them all)
# AUTOPOSTER_WORKSPACE=     # legacy: a single workspace UUID works as a list of one

